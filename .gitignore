/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Local design-hook cache, not project source
.impeccable/

# The supplied originals. 3.7 MB of 1920 px JPEGs that the site never serves:
# what it serves is public/photos/, resized from these and versioned. The
# originals stay on disk, out of the history every clone has to carry.
image/
